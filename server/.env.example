# ============================================================
#  SIGMA·CCM · Configuração da API
#  Copie para server/.env e ajuste. O .env NUNCA vai para o git.
#  Variáveis já definidas no ambiente do sistema têm prioridade.
# ============================================================

# Ambiente: development (padrão) ou production.
# Em production, todas as variáveis marcadas como [OBRIGATÓRIA EM PRODUÇÃO] precisam
# estar definidas e válidas; caso contrário a API não inicia e lista o que corrigir.
NODE_ENV=development

# [OBRIGATÓRIA EM PRODUÇÃO, exceto na Vercel] Porta HTTP da API.
PORT=3001

# [OBRIGATÓRIA EM PRODUÇÃO] Segredo de assinatura dos tokens de sessão (JWT).
# Em produção: no mínimo 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo encerra todas as sessões abertas.
JWT_SECRET=

# [OBRIGATÓRIA EM PRODUÇÃO] Validade do token de sessão: 8h, 30m, 1d ou segundos (ex.: 3600).
JWT_EXPIRES_IN=8h

# [OBRIGATÓRIA EM PRODUÇÃO] Conexão PostgreSQL (Supabase). SEGREDO DO SERVIDOR: nunca use
# em variáveis VITE_* nem no front-end. Codifique caracteres especiais da senha (@ vira %40).
# Na Vercel use o pooler do Supabase (Transaction, porta 6543):
#   postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Para db:migrate use a conexão direta/Session (porta 5432).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# SSL: disable (padrão em localhost), no-verify (padrão em banco remoto: criptografa sem
# validar a cadeia) ou require (valida a cadeia; informe DATABASE_SSL_CA com o PEM, \n escapado).
DATABASE_SSL=
DATABASE_SSL_CA=

# Pool por instância. Em serverless (Vercel) use 1 a 3 (padrão 3).
DATABASE_POOL_MAX=3
DATABASE_POOL_IDLE_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=10000

# Fuso das datas de negócio (padrão America/Sao_Paulo; em serverless o relógio é UTC).
APP_TIMEZONE=America/Sao_Paulo

# O esquema e a carga inicial NÃO rodam ao iniciar a API. Execute uma vez:
#   npm --prefix server run db:migrate
#   npm --prefix server run db:import-sqlite -- <caminho-do-banco-antigo> --confirm  (opcional, antes do bootstrap)
#   npm --prefix server run db:bootstrap
# [OBRIGATÓRIA EM PRODUÇÃO] Origens permitidas no CORS, separadas por vírgula
# (protocolo + host + porta, sem barra no final). "*" não é aceito em produção.
# Quando a API serve o próprio front-end (npm start), informe o endereço público dela.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Seed de exemplo (contas admin/pcm/campo com senhas conhecidas, equipes e OMs).
# Padrão: ligado fora de produção, desligado em produção. Use 1 ou 0.
SIGMA_SEED_EXEMPLO=

# Dados de demonstração (carga única, sem duplicar). Padrão: ligado fora de produção.
SIGMA_DEMO=

# Primeiro administrador (perfil CCM), criado pelo npm run db:bootstrap só quando o banco não tem usuários
# e o seed de exemplo está desligado (caso típico: primeira carga em produção).
# Senha com no mínimo 10 caracteres; troque-a depois do primeiro acesso.
ADMIN_USUARIO=
ADMIN_SENHA=
ADMIN_NOME=
ADMIN_EMAIL=
