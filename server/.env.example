# ============================================================
#  SIGMA·CCM · Configuração da API
#  Copie para server/.env e ajuste. O .env NUNCA vai para o git.
#  Variáveis já definidas no ambiente do sistema têm prioridade.
# ============================================================

# Ambiente: development (padrão) ou production.
# Em production, todas as variáveis marcadas como [OBRIGATÓRIA EM PRODUÇÃO] precisam
# estar definidas e válidas; caso contrário a API não inicia e lista o que corrigir.
NODE_ENV=development

# [OBRIGATÓRIA EM PRODUÇÃO] Porta HTTP da API.
PORT=3001

# [OBRIGATÓRIA EM PRODUÇÃO] Segredo de assinatura dos tokens de sessão (JWT).
# Em produção: no mínimo 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo encerra todas as sessões abertas.
JWT_SECRET=

# [OBRIGATÓRIA EM PRODUÇÃO] Validade do token de sessão: 8h, 30m, 1d ou segundos (ex.: 3600).
JWT_EXPIRES_IN=8h

# [OBRIGATÓRIA EM PRODUÇÃO] Banco de dados SQLite: caminho do arquivo,
# relativo à pasta server/ ou absoluto. O SQLite não tem usuário/senha:
# proteja o arquivo com as permissões do sistema operacional e faça backup.
DB_PATH=./sigma-ccm.db

# [OBRIGATÓRIA EM PRODUÇÃO] Origens permitidas no CORS, separadas por vírgula
# (protocolo + host + porta, sem barra no final). "*" não é aceito em produção.
# Quando a API serve o próprio front-end (npm start), informe o endereço público dela.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Seed de exemplo (contas admin/pcm/campo com senhas conhecidas, equipes e OMs).
# Padrão: ligado fora de produção, desligado em produção. Use 1 ou 0.
SIGMA_SEED_EXEMPLO=

# Dados de demonstração (carga única, sem duplicar). Padrão: ligado fora de produção.
SIGMA_DEMO=

# Primeiro administrador (perfil CCM), criado só quando o banco não tem usuários e o seed
# de exemplo está desligado (caso típico: primeira subida em produção).
# Senha com no mínimo 10 caracteres; troque-a depois do primeiro acesso.
ADMIN_USUARIO=
ADMIN_SENHA=
ADMIN_NOME=
ADMIN_EMAIL=
